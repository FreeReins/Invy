{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet run --project tests/Invy.Core.Tests:*)",
      "Bash(dotnet tool restore)",
      "Bash(./dev.sh web)",
      "Bash(./dev.sh web-test:*)",
      "Bash(./dev.sh web-shot:*)",
      "Bash(evals/waza.sh tokens:*)",
      "Bash(evals/waza.sh preflight:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Read(../chef-bot/**)",
      "Bash(./dev.sh docs-shots)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dotnet-format.sh",
            "timeout": 90,
            "statusMessage": "Tidying C# usings"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
