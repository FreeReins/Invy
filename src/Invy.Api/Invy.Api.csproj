<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!--
      The web page is built by Vite into src/Invy.Web/dist and served from there (WebPage.cs), not from this
      project's wwwroot. Without this, the SDK lists wwwroot at build time and Development runs fail when it's gone.
    -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.Http" />
    <ProjectReference Include="../Invy.Core/Invy.Core.csproj" />
  </ItemGroup>
  <!--
    Wolverine's generated code (ServiceRegistration.UseInvyGeneratedCode). Debug builds compile it at startup with
    Roslyn and ignore Internal/Generated, so stale files there can't break them. Release builds compile the files
    the codegen write command puts there (see CONTRIBUTING.md), and leave Roslyn out. The parentheses in the conditions are required.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <Compile Remove="Internal/Generated/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Editable data files live in /config at the repository root and ship next to the app. -->
    <Content Include="../../config/*.json" Link="config/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The Windows app (deploy/windows/build.ps1). InvyPayload is a folder holding wwwroot/ (the page and help),
    pgsql/ (PostgreSQL) and appsettings.Production.json, published next to the app, or packed inside Invy.exe in
    the portable build, where the Invy.Portable switch tells the app to keep its data next to the exe (PortableApp).
  -->
  <PropertyGroup Condition="'$(InvyPayload)' != ''">
    <InvyPayloadFiles>$([MSBuild]::EnsureTrailingSlash('$(InvyPayload)'))**</InvyPayloadFiles>
  </PropertyGroup>
  <ItemGroup Condition="'$(InvyPayloadFiles)' != ''">
    <Content Include="$(InvyPayloadFiles)" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(InvyPortable)' == 'true'">
    <RuntimeHostConfigurationOption Include="Invy.Portable" Value="true" />
  </ItemGroup>
</Project>
