<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything below the API: public contracts (Contracts/), and the internal managers, engines, resource
    accessors and utilities behind them. Only Contracts/ and CoreRegistration are public.
  -->
  <ItemGroup>
    <PackageReference Include="WolverineFx" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Talks to Claude for the AI features, when an admin sets up an Anthropic model. -->
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Makes attachment thumbnails. The Linux native library needs nothing installed in the container; Windows's comes with SkiaSharp. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- Only for `dotnet ef migrations add`: the migrations themselves need nothing from it at run time. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Invy.Core.Tests" />
    <!-- Dev-only scale tools in tools/: they seed and time the real accessors and managers. -->
    <InternalsVisibleTo Include="Invy.Seed" />
    <InternalsVisibleTo Include="Invy.Bench" />
  </ItemGroup>
</Project>
